# Base de datos. Dentro de Docker Compose el host es `db`.
DATABASE_URL=postgresql://boleteria:boleteria@localhost:5432/boleteria

# URL pública de la app. Mercado Pago y los enlaces de entradas la usan.
APP_URL=http://localhost:3000

# Cifra el secreto TOTP. Mínimo 32 caracteres. Distinto de QR_SECRET.
APP_SECRET=cambiame-por-un-secreto-largo-de-app

# Firma HMAC de los QR. Mínimo 32 caracteres. Distinto de APP_SECRET.
QR_SECRET=cambiame-por-un-secreto-largo-de-qr

# Carpeta de imágenes fuera de public/. En Docker se monta un volumen aquí.
UPLOAD_DIR=data/uploads

# Fase 1. El seed crea el admin solo si todavía no existe.
# La contraseña necesita 12 caracteres, una letra y un número.
ADMIN_EMAIL=
ADMIN_INITIAL_PASSWORD=

# Mercado Pago Checkout Pro. Sin token, la compra online avisa y no reserva cupo.
# El webhook exige MP_WEBHOOK_SECRET; si falta, responde 503 y no confirma pagos.
MP_ACCESS_TOKEN=
MP_WEBHOOK_SECRET=

# Vercel Cron llama a /api/cron/expire-orders una vez por día con Authorization: Bearer.
# Sin este secreto el cron responde 503.
CRON_SECRET=

# Email de entradas. Solo se envía si están los dos. No se usa SMTP.
EMAIL_FROM=
RESEND_API_KEY=
